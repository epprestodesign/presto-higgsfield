# Copy to `.env` and add your Unsplash access key for runtime imagery.
# Get one at https://unsplash.com/developers
# NOTE: this key is exposed in the client bundle — use a demo key for local dev /
# prototypes only. Do NOT set it in CI for the public GitHub Pages build.
VITE_UNSPLASH_ACCESS_KEY=

# Hosted imagery library (public URL; safe to commit). Unset = local fallback.
VITE_IMAGERY_URL=https://epprestodesign.github.io/presto-ds-imagery

# Google Maps JavaScript API key for the Hotel Map pattern.
# Get one at https://console.cloud.google.com (enable "Maps JavaScript API").
# NOTE: a Maps JS key is exposed in the client bundle by design — you MUST
# restrict it in Cloud Console by HTTP referrer + API. For the deployed build,
# store it as the GitHub Actions secret GOOGLE_MAPS_API_KEY (not in this file).
VITE_GOOGLE_MAPS_API_KEY=

# Higgsfield API (https://open.higgsfield.ai/api-keys). Local development only:
# the Storybook / prototype dev server reads these and calls Higgsfield for you,
# so the key never reaches the browser. NO "VITE_" prefix — that would bundle it.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# ── Vercel (server-side only; set these in the Vercel project, not here) ──────
# api/hf.js uses the Higgsfield key above (as Vercel env vars) and refuses
# every paid route unless Clerk is configured (503 "Auth not configured").
# Clerk: CLERK_SECRET_KEY (sk_…) or CLERK_JWT_KEY (PEM public key, networkless).
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Optional: comma-separated origins allowed to mint session tokens, e.g. https://banner-lab.vercel.app
CLERK_AUTHORIZED_PARTIES=
# Clerk → Supabase workspace sync (api/clerk-webhook.js). "whsec_…" from Clerk → Webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=
SUPABASE_URL=https://mwmiyuvyscofejorspzu.supabase.co
# Supabase secret key (service role). Server only, never VITE_-prefixed.
SUPABASE_SECRET_KEY=
