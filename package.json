{
  "name": "presto-brand-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Presto Brand Studio — self-service branded booking-page creator for EventPipe. Brand Studio GUI + the Presto design system, documented in Storybook.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prototype": "vite --config brand-studio/app/vite.config.js",
    "build-prototype": "vite build --config brand-studio/app/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "a11y:report": "node scripts/a11y-report.mjs",
    "test-stories": "node scripts/run-stories.mjs brand-studio http://localhost:6006"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@quasar/extras": "^1.16.12",
    "pinia": "^4.1.0",
    "quasar": "^2.17.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.9.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/test-runner": "^0.26.0",
    "@storybook/vue3-vite": "10.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "axe-playwright": "^2",
    "sass-embedded": "^1.83.0",
    "storybook": "10.6.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.5",
    "playwright": "^1.64.1"
  }
}
